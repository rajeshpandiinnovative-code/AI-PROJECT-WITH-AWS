{
  "name": "ai-academy-pro",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "check:env": "node scripts/check-env.cjs",
    "db:migrate": "node scripts/run-migrate.mjs",
    "migrate": "node scripts/run-migrate.mjs",
    "db:reset:dev": "node scripts/reset-public-schema.mjs",
    "digest:cron": "node scripts/run-digest-cron.mjs",
    "verify:interventions:tables": "node scripts/verify-intervention-tables.mjs",
    "verify:module-banks": "tsx scripts/verify-module-banks.ts",
    "import:schools": "tsx scripts/import-schools.ts",
    "import:srivilliputhur": "tsx scripts/import-schools.ts --board-type MATRIC --csv ./data/schools/srivilliputhur-block.csv",
    "import:udiseplus": "tsx scripts/import-schools.ts --board-type MATRIC --csv ./data/schools/udiseplus-official.csv",
    "export:schools:tenants": "tsx scripts/export-tenant-schools.ts",
    "import:schools:tenants": "tsx scripts/import-tenant-schools.ts",
    "seed:verify-school": "tsx scripts/seed-verify-school.ts",
    "db:snapshot": "tsx scripts/show-db-snapshot.ts",
    "verify": "npm run check:env && npm run lint && node -e \"console.log('Running TypeScript (noEmit)...')\" && npx tsc --noEmit",
    "verify:ci": "npm run lint && node -e \"console.log('Running TypeScript (noEmit)...')\" && npx tsc --noEmit",
    "qa": "npm run verify:ci && node scripts/next-steps.mjs",
    "scan:project": "node scripts/scan-project.mjs",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:ui": "playwright test --ui",
    "smoke": "npm run verify && npm run verify:module-banks && npm run build",
    "clean": "node -e \"try{require('fs').rmSync('.next',{recursive:true,force:true})}catch(e){}\"",
    "dev": "next dev --webpack",
    "dev:clean": "npm run clean && next dev --webpack",
    "dev:wsl": "bash scripts/wsl-dev.sh",
    "build": "next build",
    "deploy:vercel": "vercel deploy --prod",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.2",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.38.0",
    "geist": "^1.7.0",
    "lucide-react": "^1.14.0",
    "next": "16.2.4",
    "next-auth": "^5.0.0-beta.31",
    "pg": "^8.20.0",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "stripe": "^17.7.0",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "csv-parse": "^6.2.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "@playwright/test": "^1.57.0"
  }
}
