{
  "name": "ai-academy-pro",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "check:env": "node scripts/check-env.cjs",
    "db:migrate": "node scripts/run-migrate.mjs",
    "digest:cron": "node scripts/run-digest-cron.mjs",
    "import:schools": "tsx scripts/import-schools.ts",
    "import:srivilliputhur": "tsx scripts/import-schools.ts --board-type MATRIC --csv ./data/schools/srivilliputhur-block.csv",
    "import:udiseplus": "tsx scripts/import-schools.ts --board-type MATRIC --csv ./data/schools/udiseplus-official.csv",
    "verify": "npm run check:env && npm run lint && npx tsc --noEmit",
    "clean": "node -e \"try{require('fs').rmSync('.next',{recursive:true,force:true})}catch(e){}\"",
    "dev": "next dev --webpack",
    "dev:clean": "npm run clean && next dev --webpack",
    "dev:wsl": "bash scripts/wsl-dev.sh",
    "build": "next build",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.2",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.38.0",
    "geist": "^1.7.0",
    "lucide-react": "^1.14.0",
    "next": "16.2.4",
    "next-auth": "^5.0.0-beta.31",
    "pg": "^8.20.0",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "csv-parse": "^6.2.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
