# Copy to `.env.local` and fill values. Never commit `.env.local`.

# --- Required for `npm run check:env` / local dev ---
DATABASE_URL=postgresql://user:password@localhost:5432/ai_academy_pro
DATABASE_SSL=false

AUTH_SECRET=
# Legacy alias also accepted:
# NEXTAUTH_SECRET=

GEMINI_API_KEY=
GOOGLE_CLOUD_VISION_API_KEY=
MARKING_RUBRIC=

# --- Recommended ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_URL=http://localhost:3000

# --- Optional dashboard / access (defaults are permissive; see src/lib/env.ts) ---
# Email accounts without a linked school: set to false to force onboarding before /dashboard
# PLATFORM_DASHBOARD_WITHOUT_SCHOOL=false

# --- Optional billing enforcement (see src/lib/subscription.ts) ---
# REQUIRE_PAID_SUBSCRIPTION=true

# --- Stripe (checkout + webhook) ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_SCHOOL_PRO=
# STRIPE_PRICE_STUDENT_MATRIC=
# …see src/lib/billing-prices.ts

# --- Automation / admin ---
# DIGEST_CRON_TOKEN=
# ANALYTICS_ADMIN_SECRET=

# --- AI model overrides ---
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# --- Data ops (see README) ---
# UDISE directory → global_schools: npm run import:schools -- --csv ...
# Tenant schools CSV → schools table: npm run export:schools:tenants / npm run import:schools:tenants -- --csv ...
# Quick School ID login QA: npm run seed:verify-school → UUID cafebabe-0000-4000-8000-000000000001 on /login
